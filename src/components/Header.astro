---
import Logo from "./Logo.astro";
const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/portfolio/", label: "Portfolio" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <Logo animate={path === "/"} />
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
  <nav id="site-nav" class="site-nav" aria-label="Main navigation">
    {links.map((link) => <a href={link.href} class:list={{ active: path === link.href || (link.href !== "/" && path.startsWith(link.href)) }}>{link.label}</a>)}
    <a class="nav-cta" href="/contact/">Start a project <span aria-hidden="true">↗</span></a>
  </nav>
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false">
    <div id="theme-animation"></div>
  </button>
</header>