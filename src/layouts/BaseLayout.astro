---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const { title = "Rutledge Digital | Web Development", description = "Web development, e-commerce, integrations, and ongoing website support." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10110f" />
    <title>{title}</title>
    <link id="site-favicon" rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      let savedTheme;
      try { savedTheme = localStorage.getItem("theme"); } catch {}
      const theme = savedTheme === "light" ? "light" : "dark";
    
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      document.getElementById("site-favicon").href = theme === "light" ? "/vector-logo-black.svg" : "/vector-logo-white.svg";
    </script>
  </head>
  <body>
    <Header 
    />
    <main><slot /></main>
    <Footer />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>