---
const pageTitle = "Daily Habits";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f3ed" />
    <meta name="description" content="A simple daily habit scorecard." />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --paper: #f4f3ed;
        --surface: #fbfaf6;
        --ink: #252720;
        --muted: #85877d;
        --line: #dcded3;
        --soft: #e9eae1;
        --accent: #687c59;
        --accent-dark: #526746;
        --bubble-empty: #fbfaf6;
        --shadow: 0 12px 40px rgba(35, 39, 29, .055);
      }
      * { box-sizing: border-box; }
      html { background: var(--paper); color: var(--ink); }
      body { margin: 0; font-family: "DM Sans", sans-serif; background: var(--paper); min-height: 100vh; }
      button, input { font: inherit; }
      button { cursor: pointer; }
      .app-shell { width: min(760px, calc(100% - 32px)); margin: 0 auto; padding: 36px 0 64px; }
      .topline { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:36px; }
      .brand { font-size:12px; letter-spacing:.17em; font-weight:700; }
      .brand span { color:var(--muted); font-weight:400; }
      .date-label { color:var(--muted); font: 11px "DM Mono", monospace; letter-spacing:.06em; text-transform:uppercase; }
      .nav { display:flex; gap:5px; padding:5px; background:#e9eae2; border-radius:999px; width:max-content; max-width:100%; margin:0 auto 34px; }
      .nav button { border:0; background:transparent; color:var(--muted); padding:9px 18px; border-radius:999px; font-size:12px; font-weight:600; }
      .nav button[aria-current="page"] { color:var(--ink); background:var(--surface); box-shadow:0 1px 4px rgba(0,0,0,.06); }
      .screen { animation: appear .18s ease-out; }
      @keyframes appear { from { opacity:.55; transform:translateY(4px); } to {opacity:1;transform:none;} }
      .screen-head { display:flex; justify-content:space-between; align-items:end; gap:16px; margin-bottom:24px; }
      h1 { font-size:clamp(27px, 5vw, 38px); letter-spacing:-.055em; line-height:1.05; margin:0; font-weight:600; }
      .eyebrow { color:var(--muted); font:10px "DM Mono",monospace; letter-spacing:.14em; text-transform:uppercase; margin:0 0 10px; }
      .subtle { color:var(--muted); font-size:13px; line-height:1.55; }
      .progress-pill { border:1px solid var(--line); border-radius:999px; padding:8px 12px; font:11px "DM Mono",monospace; white-space:nowrap; }
      .score-card { background:var(--surface); border:1px solid var(--line); border-radius:24px; padding:clamp(18px,4vw,30px); box-shadow:var(--shadow); }
      .bubble-list { display:grid; gap:0; }
      .habit-row { min-height:62px; display:grid; grid-template-columns:38px 1fr 42px; align-items:center; border-bottom:1px solid #ecece5; }
      .habit-row:last-child { border-bottom:0; }
      .habit-number { color:#a1a397; font:11px "DM Mono",monospace; }
      .habit-name { font-size:14px; color:#55594f; }
      .bubble { width:31px; height:31px; border-radius:50%; border:1.6px solid #aeb2a5; background:var(--bubble-empty); display:grid; place-items:center; color:white; padding:0; justify-self:end; transition:background .15s, border-color .15s, transform .15s; }
      .bubble:active { transform:scale(.91); color:black;}
      .bubble.done { background:var(--accent); border-color:var(--accent); }
      .bubble svg { width:15px; height:15px; }
      .daily-foot { display:flex; justify-content:space-between; align-items:center; margin-top:20px; color:var(--muted); font:10px "DM Mono",monospace; letter-spacing:.04em; }
      .text-button { border:0; background:transparent; color:var(--muted); padding:7px 0; font-size:12px; }
      .text-button:hover { color:var(--ink); }
      .help-panel { background:#eeefe7; border-radius:14px; padding:14px 16px; margin-top:14px; }
      .help-panel ol { margin:0; padding-left:20px; display:grid; gap:7px; color:#62665b; font-size:12px; }
      .empty-state { text-align:center; padding:42px 20px; }
      .empty-state p { max-width:330px; margin:12px auto 20px; }
      .primary { background:var(--ink); color:#fff; border:0; border-radius:999px; padding:12px 20px; font-size:12px; font-weight:600; }
      .primary:hover { background:#41463a; }
      .secondary { background:transparent; color:var(--ink); border:1px solid var(--line); border-radius:999px; padding:10px 16px; font-size:12px; }
      .history-card { background:var(--surface); border:1px solid var(--line); border-radius:20px; overflow:hidden; box-shadow:var(--shadow); }
      .history-scroll { overflow-x:auto; }
      .history-grid { min-width:max-content; padding:18px 20px 12px; }
      .history-row { display:grid; grid-template-columns:92px repeat(var(--habit-count), 22px); align-items:center; column-gap:10px; min-height:37px; }
      .history-row + .history-row { border-top:1px solid #efefe9; }
      .history-row.header { min-height:30px; border:0; }
      .history-date { color:#73776c; font:10px "DM Mono",monospace; }
      .history-dot { width:12px; height:12px; border-radius:50%; border:1px solid #b9bcb1; justify-self:center; }
      .history-dot.done { background:var(--accent); border-color:var(--accent); }
      .history-row.header .history-dot { border:0; width:auto; height:auto; border-radius:0; color:#a0a397; font:9px "DM Mono",monospace; }
      .history-row.today .history-date { color:var(--accent-dark); font-weight:500; }
      .history-legend { display:flex; gap:16px; align-items:center; padding:14px 20px; border-top:1px solid var(--line); color:var(--muted); font:9px "DM Mono",monospace; }
      .legend-item { display:flex; align-items:center; gap:7px; }
      .legend-dot { width:9px; height:9px; border:1px solid #b9bcb1; border-radius:50%; }
      .legend-dot.filled { background:var(--accent); border-color:var(--accent); }
      .stats-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-bottom:14px; }
      .stat-card { background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:20px; }
      .stat-value { font-size:32px; letter-spacing:-.06em; margin:7px 0 2px; }
      .stat-label { color:var(--muted); font-size:11px; }
      .section-title { font-size:14px; font-weight:600; margin:26px 0 12px; }
      .performance-list { background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:4px 18px; }
      .performance-row { display:grid; grid-template-columns:1fr auto; gap:10px; align-items:center; padding:14px 0; border-bottom:1px solid #ecece5; }
      .performance-row:last-child { border-bottom:0; }
      .performance-name { font-size:12px; }
      .performance-meta { color:var(--muted); font:10px "DM Mono",monospace; margin-top:4px; }
      .bar { height:4px; background:#e9eae2; border-radius:9px; margin-top:9px; overflow:hidden; }
      .bar > span { display:block; height:100%; background:var(--accent); border-radius:9px; }
      .percentage { font:11px "DM Mono",monospace; color:var(--muted); }
      .setup-list { display:grid; gap:8px; }
      .setup-row { display:grid; grid-template-columns:26px 1fr auto; align-items:center; gap:10px; background:var(--surface); border:1px solid var(--line); border-radius:13px; padding:9px 11px; }
      .setup-index { color:var(--muted); font:10px "DM Mono",monospace; }
      .setup-name { min-width:0; width:100%; border:0; outline:0; background:transparent; color:var(--ink); font-size:13px; padding:5px 0; }
      .row-actions { display:flex; gap:2px; }
      .icon-button { border:0; background:transparent; color:var(--muted); border-radius:8px; padding:7px; font-size:12px; }
      .icon-button:hover { background:var(--soft); color:var(--ink); }
      .add-row { display:flex; gap:9px; margin-top:14px; }
      .add-row input { min-width:0; flex:1; border:1px solid var(--line); background:var(--surface); border-radius:999px; padding:11px 15px; outline:none; font-size:12px; }
      .add-row input:focus { border-color:#9da88f; }
      .setup-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; padding-top:18px; border-top:1px solid var(--line); }
      .footer-note { text-align:center; color:#a1a397; font:9px "DM Mono",monospace; margin-top:34px; letter-spacing:.08em; }
      .toast { position:fixed; left:50%; bottom:24px; transform:translate(-50%,15px); background:var(--ink); color:white; border-radius:999px; padding:11px 17px; font-size:11px; opacity:0; pointer-events:none; transition:.2s; z-index:10; }
      .toast.show { opacity:1; transform:translate(-50%,0); }
      @media (max-width:520px) {
        .app-shell { width:calc(100% - 24px); padding-top:24px; }
        .topline { margin-bottom:27px; }
        .nav { margin-bottom:27px; }
        .nav button { padding:9px 14px; }
        .screen-head { align-items:center; }
        .score-card { border-radius:19px; }
        .habit-row { min-height:59px; }
      }
    </style>
  </head>
  <body>
    <main class="app-shell">
      <header class="topline">
        <div class="brand">DAILY SCORECARD</div>
        <div class="date-label" id="header-date"></div>
      </header>
      <nav class="nav" aria-label="Main navigation">
        <button data-screen="today" aria-current="page"><img src="check.png" alt="Submit" width="32" height="32"></button>
        <button data-screen="history"><img src="calendar.png" alt="Submit" width="32" height="32"></button>
        <button data-screen="stats"><img src="stats.png" alt="Submit" width="32" height="32"></button>
        <button data-screen="setup"><img src="cog.png" alt="Submit" width="32" height="32"></button>
      </nav>
      <div id="app"></div>
      <div class="footer-note">Special thanks to Alzam, Larea, Miftakhul Rizky, and Rendicon<br>from the Noun Project for their icon designs.</div>
    </main>
    <div class="toast" id="toast" role="status"></div>
    <script is:inline src="/habits.js"></script>
  </body>
</html>
