---
import "../styles/habits.css";
const pageTitle = "Daily Habits";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f3ed" />
    <meta name="description" content="A simple daily habit scorecard." />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="app-shell">
      <header class="topline">
        <div class="brand">DAILY SCORECARD</div>
        <div class="date-label" id="header-date"></div>
      </header>
      <nav class="nav" aria-label="Main navigation">
        <button data-screen="today" aria-current="page"><img src="/check.png" alt="Today" width="32" height="32"></button>
        <button data-screen="history"><img src="/calendar.png" alt="History" width="32" height="32"></button>
        <button data-screen="stats"><img src="/stats.png" alt="Statistics" width="32" height="32"></button>
        <button data-screen="setup"><img src="/cog.png" alt="Setup" width="32" height="32"></button>
      </nav>
      <div id="app"></div>
      <div class="footer-note">Special thanks to Alzam, Larea, Miftakhul Rizky, and Rendicon<br>from the Noun Project for their icon designs.</div>
    </main>
    <div class="toast" id="toast" role="status"></div>
    <script>
      import "../scripts/habits/app.js";
    </script>
  </body>
</html>
