---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects.js";
---
<BaseLayout title="Rutledge Digital | Websites and E-commerce" description="Custom websites, e-commerce experiences, integrations, and ongoing support from Rutledge Digital.">
  <section class="hero section-wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> WEB DEVELOPMENT · UTAH</p>
      <h1>Digital experiences,<br /><span class="accent">built with purpose.</span></h1>
      <p class="hero-lede">I help businesses turn website ideas into useful, polished experiences—from a clear first impression to custom features that make work easier.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact/">Let's talk about your project <span aria-hidden="true">↗</span></a>
        <a class="button button-quiet" href="/portfolio/">Explore my work <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-proof"><span>Custom development</span><span>WordPress & Shopify</span><span>Integrations & support</span></div>
    </div>
    <div class="hero-art" aria-label="Abstract graphic representing connected digital systems">
      <div class="art-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      <div class="art-center"><span class="art-symbol">R<span>.</span></span><span class="art-caption">DESIGN · BUILD · IMPROVE</span></div>
      <span class="art-label label-top">01 / STRATEGY</span><span class="art-label label-bottom">02 / DEVELOPMENT</span>
    </div>
  </section>

  <section class="intro-band">
    <div class="section-wrap intro-grid"><p class="eyebrow">A PRACTICAL PARTNER</p><p class="intro-statement">Your website should do more than look good. <span>It should make it easier for customers to understand, trust, and choose your business.</span></p></div>
  </section>

  <section class="section-wrap section-block">
    <div class="section-heading"><div><p class="eyebrow">WHAT I CAN HELP WITH</p><h2>From first launch<br />to what comes next.</h2></div><a class="text-link" href="/services/">All services <span aria-hidden="true">↗</span></a></div>
    <div class="service-grid">
      <article class="service-card"><span class="service-index">01</span><div class="service-icon">↗</div><h3>Website design & development</h3><p>Fast, responsive websites shaped around your business, customers, and goals.</p><a href="/services/" class="text-link">Learn more ↗</a></article>
      <article class="service-card"><span class="service-index">02</span><div class="service-icon">◈</div><h3>E-commerce & custom features</h3><p>Shopify, WordPress, product experiences, and interactive features beyond the basics.</p><a href="/services/" class="text-link">Learn more ↗</a></article>
      <article class="service-card"><span class="service-index">03</span><div class="service-icon">⟳</div><h3>Maintenance & integrations</h3><p>Updates, troubleshooting, data connections, automation, and ongoing improvements.</p><a href="/services/" class="text-link">Learn more ↗</a></article>
    </div>
  </section>

  <section class="section-wrap section-block featured-work">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2>Curiosity, meet<br />real-world problems.</h2></div><a class="text-link" href="/portfolio/">View portfolio <span aria-hidden="true">↗</span></a></div>
    <div class="project-grid">
      {projects.slice(0, 3).map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <section class="cta-band"><div class="section-wrap cta-content"><p class="eyebrow">HAVE SOMETHING IN MIND?</p><h2>Let's make your website<br /><span class="accent">work harder for you.</span></h2><a class="button button-primary" href="/contact/">Tell me what you're building <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>