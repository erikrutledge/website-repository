---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Rutledge Digital" description="Start a conversation about your website project with Rutledge Digital.">
  <section class="page-hero section-wrap">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk about<br /><span class="accent">what comes next.</span></h1>
    <p class="hero-lede">Tell me a little about your business and what you'd like your website to do. I'll follow up to discuss goals, options, and next steps.</p>
  </section>
  <section class="section-wrap contact-grid">
    <div class="contact-copy">
      <p class="eyebrow">Start a conversation</p>
      <h2>Good projects start<br />with a clear brief.</h2>
      <p>Share as much or as little as you know right now. You don't need a finished plan to get started.</p>
      <div class="contact-detail">
        <span class="contact-symbol" aria-hidden="true">↗</span>
        <div>
          <b>Email</b>
          <p>Replace this with your business email before launch.</p>
        </div>
      </div>
      <div class="contact-detail">
        <span class="contact-symbol" aria-hidden="true">◎</span>
        <div>
          <b>What happens next?</b>
          <p>We'll talk through your goals, timing, budget, and what a sensible first step looks like.</p>
        </div>
      </div>
    </div>
    <form class="contact-form" action="mailto:erikrutledge.com" method="post" enctype="text/plain">
      <label for="name">Your name</label>
      <input id="name" name="Name" autocomplete="name" required />
      <label for="email">Email address</label>
      <input id="email" name="Email" type="email" autocomplete="email" required />
      <label for="business">Business or website (optional)</label>
      <input id="business" name="Business or website" autocomplete="url" />
      <label for="project">What do you need help with?</label>
      <select id="project" name="Project type">
        <option>New website</option>
        <option>Redesign</option>
        <option>Maintenance and updates</option>
        <option>E-commerce</option>
        <option>Not sure yet</option>
      </select>
      <label for="message">Tell me about your project</label>
      <textarea id="message" name="Message" rows="5" required></textarea>
      <button class="button button-primary" type="submit">Prepare email <span aria-hidden="true">↗</span></button>
      <p class="form-fineprint">This starter uses an email-client handoff, not a secure form-processing service. Don't collect sensitive information here.</p>
    </form>
  </section>
</BaseLayout>
