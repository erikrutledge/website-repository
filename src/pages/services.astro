---
import BaseLayout from '../layouts/BaseLayout.astro';
const offerings = [
  { n: '01', title: 'New website builds', text: 'A purpose-built site for a new business, a new offering, or a fresh start. We’ll focus on your audience, clear messaging, mobile usability, and a straightforward path to contact you.', includes: ['Planning and page structure', 'Responsive design and development', 'Basic on-page SEO setup', 'Launch support'] },
  { n: '02', title: 'Website redesigns', text: 'If your current site feels dated, confusing, or difficult to use, improve it without losing sight of what already works.', includes: ['Review of the existing site', 'Visual and usability improvements', 'Mobile and performance review', 'Content and navigation cleanup'] },
  { n: '03', title: 'Maintenance & updates', text: 'A website is not always finished at launch. Get a defined, predictable way to request changes and keep the site healthy.', includes: ['Scheduled content changes', 'Dependency and platform updates where applicable', 'Backup and uptime plan where supported', 'A clearly defined support allowance'] },
  { n: '04', title: 'E-commerce websites', text: 'Help customers find products, understand your offer, and complete purchases using a platform that fits your business and team.', includes: ['Storefront setup and styling', 'Product and collection organization', 'Checkout and key-flow testing', 'Platform and app cost transparency'] },
];
---
<BaseLayout title="Services | Rutledge Digital" description="Website builds, redesigns, maintenance, and e-commerce support.">
  <section class="page-hero section-pad"><div class="container narrow"><p class="eyebrow">Services</p><h1>Practical web solutions<br /><span>for growing businesses.</span></h1><p class="hero-lede">The right solution depends on your goals, budget, and how you want to manage your site. We'll choose tools that fit—not add complexity for its own sake.</p></div></section>
  <section class="section-pad page-content"><div class="container"><div class="offering-list">{offerings.map((item) => <article class="offering"><div class="offering-heading"><span class="service-number">{item.n}</span><h2>{item.title}</h2></div><div class="offering-detail"><p>{item.text}</p><ul>{item.includes.map((line) => <li>{line}</li>)}</ul></div></article>)}</div><div class="note-panel"><span class="note-icon">✳</span><div><h2>Clear scope. No surprise subscriptions.</h2><p>Before work begins, you'll know what is included, what ongoing support costs, and which third-party services—such as hosting, domains, apps, or payment processing—are billed separately.</p></div></div><div class="center-cta"><h2>Not sure what you need yet?</h2><p>Tell me what’s working, what isn’t, and what you want your website to do.</p><a class="button" href="/contact/">Let's figure it out <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
