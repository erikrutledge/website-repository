---
import PlatformExperience from "../components/PlatformExperience.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
---
<BaseLayout title="Portfolio | Rutledge Digital" description="The businesses and people Erik Rutledge has worked with, and the platforms and technologies behind the work.">
  <section class="page-hero section-wrap portfolio-businesses" aria-labelledby="businesses-heading">
    <p class="eyebrow">PORTFOLIO · BUSINESSES & PEOPLE</p>
    <h1 id="businesses-heading">Real businesses.<br /><span class="accent">Personal partnerships.</span></h1>
    <p class="hero-lede">Whether you own a custom print shop on Shopify, a holistic healthcare practice, or anything in between, my work starts with the people behind the business and ends with a solution to their problems.</p>
    <ProjectCarousel id="portfolio-projects" label="Businesses and people I’ve worked with" />
  </section>
  <PlatformExperience portfolio />
</BaseLayout>
