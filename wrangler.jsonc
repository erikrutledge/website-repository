{
    "name": "website-repository",
    "main": "./dist/_worker.js/index.js",
    "compatibility_date": "2026-10-24",
    "compatibility_flags": [
      "nodejs_compat",
      "global_fetch_strictly_public"
    ],
    "vars": {
      "CONTACT-FROM-EMAIL": "website@send.erikrutledge.com",
      "CONTACT-TO-EMAIL": "erik.rutledge14@gmail.com"
    },
    "assets": {
      "binding": "ASSETS",
      "directory": "./dist"
    },
    "observability": {
      "enabled": true
    }
  }