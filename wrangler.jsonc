{
    "name": "website-repository",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "compatibility_date": "2026-10-24",
    "compatibility_flags": [
      "nodejs_compat",
      "global_fetch_strictly_public"
    ],
    "vars": {
      "CONTACT-FROM-EMAIL": "forms@erikrutledge.com",
      "CONTACT-TO-EMAIL": "erik.rutledge14@gmail.com"
    },
    "assets": {
      "binding": "ASSETS"
    },
    "observability": {
      "enabled": true
    }
  }
